{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://jji077bi8e.execute-api.eu-west-3.amazonaws.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS": "285796240127-ljujk2ubnq4bgav0s97vgcg19plaldgd.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID": "285796240127-hk6j6351rcc0oqljcfm4ttfs2idcg8c7.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB": "285796240127-pbq954l1010v0fce5o0smklvvju6o7de.apps.googleusercontent.com"
      }
    },
    "development-simulator": {
      "extends": "development",
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "distribution": "internal",
      "ios": {
        "buildConfiguration": "Release"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://jji077bi8e.execute-api.eu-west-3.amazonaws.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS": "285796240127-ljujk2ubnq4bgav0s97vgcg19plaldgd.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID": "285796240127-hk6j6351rcc0oqljcfm4ttfs2idcg8c7.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB": "285796240127-pbq954l1010v0fce5o0smklvvju6o7de.apps.googleusercontent.com"
      }
    },
    "production": {
      "ios": {
        "buildConfiguration": "Release",
        "autoIncrement": true
      },
      "android": {
        "buildType": "app-bundle",
        "autoIncrement": true
      },
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.mediasummarizer.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS": "285796240127-ljujk2ubnq4bgav0s97vgcg19plaldgd.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID": "285796240127-hk6j6351rcc0oqljcfm4ttfs2idcg8c7.apps.googleusercontent.com",
        "EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB": "285796240127-pbq954l1010v0fce5o0smklvvju6o7de.apps.googleusercontent.com"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "${APPLE_ID}",
        "ascAppId": "${ASC_APP_ID}",
        "appleTeamId": "${APPLE_TEAM_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "internal"
      }
    },
    "production-store": {
      "ios": {
        "appleId": "${APPLE_ID}",
        "ascAppId": "${ASC_APP_ID}",
        "appleTeamId": "${APPLE_TEAM_ID}"
      },
      "android": {
        "serviceAccountKeyPath": "./google-services-key.json",
        "track": "production"
      }
    }
  }
}
