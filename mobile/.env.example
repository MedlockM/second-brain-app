# API base URL for the backend
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000

# RevenueCat API keys (platform-specific, from RevenueCat dashboard)
EXPO_PUBLIC_REVENUCAT_APPLE_KEY=your_revenucat_apple_api_key_here
EXPO_PUBLIC_REVENUCAT_GOOGLE_KEY=your_revenucat_google_api_key_here

# Google OAuth — mobile public client IDs (consumed by Expo via EXPO_PUBLIC_*)
# IOS_CLIENT_ID is the iOS OAuth client created in Google Cloud Console (bundle id = mobile app.config.ts ios.bundleIdentifier)
# ANDROID_CLIENT_ID is created later (Phase 5) once eas build provides the production keystore SHA-1
# WEB_CLIENT_ID is the same value as GOOGLE_CLIENT_ID above (backend Web client) — used by Expo to verify id_token aud
EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_ANDROID=
EXPO_PUBLIC_GOOGLE_CLIENT_ID_WEB=

# Feedback board URL (Canny). Used as fallback when the SSO token endpoint is
# unavailable. Set this once the Canny board subdomain is finalised (the slug
# is decided in the Canny dashboard, Settings > Subdomain).
#   Free tier example:  https://<your-slug>.canny.io
#   Core tier example:  https://feedback.<your-domain>
# Leave empty until the slug is finalised — the app will surface an explicit
# error to the user instead of opening a broken URL.
EXPO_PUBLIC_FEEDBACK_URL=
