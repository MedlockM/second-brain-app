<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <style>
      body{font-family:Arial,Helvetica,sans-serif;color:{{ brand.text }};background:linear-gradient(135deg, {{ brand.bg_from }}, {{ brand.bg_to }})}
      .container{max-width:600px;margin:0 auto;padding:16px}
      .header{background:linear-gradient(90deg, {{ brand.primary_start }}, {{ brand.primary_end }});color:#fff;padding:16px;border-radius:10px;font-size:18px;font-weight:700;margin:0 0 12px}
      .meta{font-size:13px;color:{{ brand.muted }};margin-bottom:12px}
      input{display:none}
      .page{display:none}
      .page.active{display:block}
      .question{font-size:16px;margin:12px 0;font-weight:600;color:{{ brand.text }}}
      .choice{margin:8px 0}
      .choice label{display:block;border:1px solid {{ brand.border }};border-radius:8px;padding:12px;background:#fff}
      .choice input:checked + label.correct{border-color:{{ brand.primary_start }};box-shadow:0 0 0 2px rgba(37,99,235,0.1), inset 0 0 0 9999px {{ brand.correct_bg }}; color:{{ brand.correct_text }}}
      .choice input:checked + label.incorrect{border-color:{{ brand.primary_start }};box-shadow:0 0 0 2px rgba(37,99,235,0.1), inset 0 0 0 9999px {{ brand.incorrect_bg }}; color:{{ brand.incorrect_text }}}
      .nav{display:flex;justify-content:space-between;margin-top:12px}
      .btn{display:inline-block;background:linear-gradient(90deg, {{ brand.primary_start }}, {{ brand.primary_end }});color:{{ brand.button_text }};text-decoration:none;padding:10px 14px;border-radius:8px;font-weight:600}
      .footer{font-size:12px;color:{{ brand.muted }};margin-top:10px}
      /* Pagination via radios */
      {% for q in quiz.questions %}
      #p{{ loop.index0 }}:checked ~ .pages .page-{{ loop.index0 }}{display:block}
      {% endfor %}
      /* Summary toggle */
      #toggle-summary:checked ~ .summary{display:block}
      .summary{display:none;border:1px solid #ddd;border-radius:6px;padding:12px;margin-top:12px}
      /* iOS scroll/animation (optional) */
      @media (max-device-width:600px){.page{animation:fadein 0.6s}}
      @keyframes fadein{0%{opacity:0}100%{opacity:1}}
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">{{ podcast_title }} — {{ episode_title }}</div>
      <div class="meta">{{ ui_strings.get('intro', 'Answer the quiz below, then reveal the summary.') }}</div>

      <form>
        <!-- pagination radios -->
        {% for q in quiz.questions %}
        <input type="radio" name="page" id="p{{ loop.index0 }}" {% if loop.first %}checked{% endif %}>
        {% endfor %}

        <div class="pages">
          {% for q in quiz.questions %}
            {% set qidx = loop.index0 %}
            <div class="page page-{{ qidx }}">
              <div class="question">Q{{ qidx + 1 }}. {{ q.prompt }}</div>
              {% for choice in q.choices %}
                {% set cid = 'c' ~ qidx ~ '-' ~ loop.index0 %}
                <div class="choice">
                  {% if q.multiple %}
                    <input type="checkbox" id="{{ cid }}">
                  {% else %}
                    <input type="radio" name="q{{ qidx }}" id="{{ cid }}">
                  {% endif %}
                  <label for="{{ cid }}" class="{% if choice.correct %}correct{% else %}incorrect{% endif %}">{{ choice.text }}</label>
                </div>
              {% endfor %}
              <div class="nav">
                {% if not loop.first %}<label class="btn" for="p{{ qidx - 1 }}">{{ ui_strings.get('prev', 'Previous') }}</label>{% else %}<span></span>{% endif %}
                {% if not loop.last %}<label class="btn" for="p{{ qidx + 1 }}">{{ ui_strings.get('next', 'Next') }}</label>{% else %}<span class="footer">{{ ui_strings.get('final_note', 'You can review your selections above.') }}</span>{% endif %}
              </div>
            </div>
          {% endfor %}
        </div>

        <!-- Reveal Summary -->
        <div style="margin-top:14px">
          <input type="checkbox" id="toggle-summary">
          <label class="btn" for="toggle-summary">{{ ui_strings.get('reveal_summary', 'Reveal Summary') }}</label>
          <div class="summary">
            {% if summary and summary.main_topics %}
              <h4>{{ ui_strings.get('main_topics', 'Main topics') }}</h4>
              <ul>
                {% for t in summary.main_topics %}<li>{{ t }}</li>{% endfor %}
              </ul>
            {% endif %}
            {% if summary and summary.key_points %}
              <h4>{{ ui_strings.get('key_points', 'Key points') }}</h4>
              <ul>
                {% for p in summary.key_points %}<li>{{ p }}</li>{% endfor %}
              </ul>
            {% endif %}
            {% if summary and summary.notable_quotes %}
              <h4>{{ ui_strings.get('notable_quotes', 'Notable quotes') }}</h4>
              <ul>
                {% for q in summary.notable_quotes %}<li>“{{ q }}”</li>{% endfor %}
              </ul>
            {% endif %}
            {% if summary and summary.conclusion %}
              <h4>{{ ui_strings.get('conclusion', 'Conclusion') }}</h4>
              <p>{{ summary.conclusion }}</p>
            {% endif %}
          </div>
        </div>
      </form>

      <div class="footer">{{ ui_strings.get('compat_note', 'Interactive behavior works best in iOS/Apple/Samsung Mail. Others will see the static version.') }}</div>
    </div>
  </body>
</html>