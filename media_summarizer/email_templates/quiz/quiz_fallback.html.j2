<!DOCTYPE html>
<html>
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <style>
      body{font-family:Arial,Helvetica,sans-serif;color:{{ brand.text }};background:linear-gradient(135deg, {{ brand.bg_from }}, {{ brand.bg_to }})}
      .container{max-width:600px;margin:0 auto;padding:16px}
      .header{background:linear-gradient(90deg, {{ brand.primary_start }}, {{ brand.primary_end }});color:#fff;padding:16px;border-radius:10px;font-size:18px;font-weight:700;margin:0 0 12px}
      .meta{font-size:13px;color:{{ brand.muted }};margin-bottom:12px}
      .question{font-size:16px;margin:12px 0}
      .choice{margin:8px 0}
      .correct{color:#166534}
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header">{{ podcast_title }} — {{ episode_title }}</div>
      <div class="meta">{{ ui_strings.get('fallback_note', 'Your email client does not support interactive content. Here is a static version of the quiz:') }}</div>

      {% for q in quiz.questions %}
        <div class="question">Q{{ loop.index }}. {{ q.prompt }}</div>
        <ul>
          {% for choice in q.choices %}
            <li class="choice {% if choice.correct %}correct{% endif %}">{{ choice.text }} {% if choice.correct %}✓{% endif %}</li>
          {% endfor %}
        </ul>
      {% endfor %}

      <hr/>
      <h4 id="summary">{{ ui_strings.get('reveal_summary', 'Reveal Summary') }}</h4>
      {% if summary and summary.main_topics %}
        <h5>{{ ui_strings.get('main_topics', 'Main topics') }}</h5>
        <ul>{% for t in summary.main_topics %}<li>{{ t }}</li>{% endfor %}</ul>
      {% endif %}
      {% if summary and summary.key_points %}
        <h5>{{ ui_strings.get('key_points', 'Key points') }}</h5>
        <ul>{% for p in summary.key_points %}<li>{{ p }}</li>{% endfor %}</ul>
      {% endif %}
      {% if summary and summary.notable_quotes %}
        <h5>{{ ui_strings.get('notable_quotes', 'Notable quotes') }}</h5>
        <ul>{% for q in summary.notable_quotes %}<li>“{{ q }}”</li>{% endfor %}</ul>
      {% endif %}
      {% if summary and summary.conclusion %}
        <h5>{{ ui_strings.get('conclusion', 'Conclusion') }}</h5>
        <p>{{ summary.conclusion }}</p>
      {% endif %}
    </div>
  </body>
</html>