# Environment Configuration Example
# Copy this file to .env and fill in your actual values

# =============================================================================
# ENVIRONMENT SETTINGS
# =============================================================================
# Environment type: development, production
ENVIRONMENT=development

# =============================================================================
# WHISPER MODEL CONFIGURATION
# =============================================================================
# Whisper model size: tiny, large
# - tiny: Fast, low accuracy (good for development/testing)
# - large: Slow, high accuracy (recommended for production)
WHISPER_MODEL_SIZE=tiny

# Active transcription provider (Whisper remains available for future fallback)
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_API_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TIMEOUT_SECONDS=300
DEEPGRAM_API_RETRIES=3
DEEPGRAM_WORKER_MAX_RETRIES=3
DEEPGRAM_DETECT_LANGUAGE=true
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_PARAGRAPHS=true
DEEPGRAM_UTTERANCES=true
YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=20
YTDLP_TIMEOUT_SECONDS=30
TIKTOK_SUBTITLE_FETCH_TIMEOUT_SECONDS=20
TIKTOK_WORKER_MAX_RETRIES=3
GETINSAVER_API_BASE_URL=https://getinsaver.com/api/v1
GETINSAVER_API_KEY=your_getinsaver_api_key_here
GETINSAVER_TIMEOUT_SECONDS=20

# =============================================================================
# AWS CONFIGURATION
# =============================================================================
# AWS Region
AWS_DEFAULT_REGION=us-east-1

# AWS Credentials (not needed for LocalStack in development)
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here

# LocalStack endpoint (development only)
AWS_ENDPOINT_URL=http://localhost:4566

# =============================================================================
# S3 BUCKET CONFIGURATION
# =============================================================================
AUDIO_BUCKET=media-summarizer-audio
TRANSCRIPT_BUCKET=media-summarizer-transcriptions
SUMMARY_BUCKET=media-summarizer-summaries

# =============================================================================
# SQS QUEUE CONFIGURATION
# =============================================================================
AUDIO_DOWNLOAD_QUEUE=audio-download-queue
TRANSCRIPTION_QUEUE=transcription-queue
DEEPGRAM_TRANSCRIPTION_QUEUE=deepgram-transcription-queue
YOUTUBE_INGESTION_QUEUE=youtube-ingestion-queue
TIKTOK_INGESTION_QUEUE=tiktok-ingestion-queue
SUMMARIZATION_QUEUE=summarization-queue
EPISODE_COMPLETION_EVENTS_QUEUE=episode-completion-events
PODCASTINDEX_RESOLUTION_QUEUE=podcastindex-resolution-queue
PODCASTINDEX_RESOLUTION_DLQ=podcastindex-resolution-dlq
ARTICLE_EXTRACTION_QUEUE=article-extraction-queue
# Visibility & heartbeat (for long-running tasks)
TRANSCRIPTION_VISIBILITY_TIMEOUT=1800
DEEPGRAM_VISIBILITY_TIMEOUT=1800
HEARTBEAT_INTERVAL=60
ARTICLE_WORKER_MAX_RETRIES=3

# Article extraction worker
ARTICLE_EXTRACT_TIMEOUT_SECONDS=20
ARTICLE_EXTRACT_MAX_HTML_BYTES=2000000
ARTICLE_EXTRACT_USER_AGENT=media-summarizer/article-extractor (+https://media-summarizer.local)

# =============================================================================
# AI SERVICES
# =============================================================================
# OpenAI API Key for GPT-4 summarization
OPENAI_API_KEY=your_openai_api_key_here
LLM_API_URL=https://api.openai.com/v1/chat/completions

# PodcastIndex.org API credentials
PODCASTINDEXORG_API_KEY=your_podcastindex_api_key_here
PODCASTINDEXORG_API_SECRET=your_podcastindex_api_secret_here
PODCASTINDEX_RATE_LIMIT_ENABLED=true
PODCASTINDEX_RATE_LIMIT_RPS=1
PODCASTINDEX_LIMITER_REDIS_URL=redis://redis:6379/0
PODCASTINDEX_LIMITER_KEY=podcastindex:global:next_allowed_ms
PODCASTINDEX_LIMITER_TTL_MS=60000
PODCASTINDEX_MAX_RETRIES=3
PODCASTINDEX_WORKER_MAX_RETRIES=3
PODCASTINDEX_EPISODE_CANDIDATES=50
TIKTOK_RATE_LIMIT_ENABLED=true
TIKTOK_RATE_LIMIT_PER_HOUR=100
TIKTOK_MIN_INTERVAL_SECONDS=3
TIKTOK_LIMITER_REDIS_URL=redis://redis:6379/0
TIKTOK_LIMITER_KEY=tiktok:global:next_allowed_ms
TIKTOK_LIMITER_TTL_MS=60000
TIKTOK_LIMITER_HOURLY_KEY_PREFIX=tiktok:global:hour_bucket
X_API_BEARER_TOKEN=your_x_api_bearer_token_here
X_INGESTION_QUEUE=x-ingestion-queue
X_API_TIMEOUT_SECONDS=20
X_WORKER_MAX_RETRIES=3

# =============================================================================
# PAYMENT PROCESSING
# =============================================================================
# Stripe API Keys
STRIPE_API_KEY=your_stripe_api_key_here
# STRIPE_TEST_API_KEY removed — use STRIPE_API_KEY for both test and live (use sk_test_* in dev)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Automatic Payment Methods redirect policy
# Controls whether Stripe may use redirect-based payment methods when confirming PaymentIntents.
# Values: "always" (production default) or "never" (recommended for tests/CI).
# If unset, Stripe defaults to allowing redirects.
# STRIPE_REDIRECT_POLICY=always

# Stripe Checkout configuration (Price IDs and redirect URLs)
# Subscriptions (minutes per month): S=240, M=840, L=1980
STRIPE_PRICE_ID_SUB_S=price_your_sub_s
STRIPE_PRICE_ID_SUB_M=price_your_sub_m
STRIPE_PRICE_ID_SUB_L=price_your_sub_l
# Packs (one-shot minutes)
STRIPE_PRICE_ID_PACK_100=price_pack_100
STRIPE_PRICE_ID_PACK_300=price_pack_300
STRIPE_PRICE_ID_PACK_600=price_pack_600
STRIPE_PRICE_ID_PACK_1200=price_pack_1200

# Success/Cancel URLs for Stripe Checkout redirects
# Typically point to your frontend routes
STRIPE_SUCCESS_URL=https://app.yourdomain.com/payment-success
STRIPE_CANCEL_URL=https://app.yourdomain.com/payment-cancel

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# DynamoDB table names
USERS_TABLE=users
PROCESSING_JOBS_TABLE=processing_jobs
MEDIA_IDEMPOTENCE_TABLE=media_idempotence
MEDIA_WATCHERS_TABLE=media_watchers
USER_MEDIA_SUBMISSIONS_TABLE=user_media_submissions
# Minutes-based billing tables
SUBSCRIPTIONS_TABLE=subscriptions
MINUTE_BUCKETS_TABLE=minute_buckets
MINUTE_USAGE_TABLE=minute_usage
FOLLOWS_TABLE=follows

# =============================================================================
# EMAIL CONFIGURATION
# =============================================================================
# SES configuration for email notifications
FROM_EMAIL=noreply@yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
# Frontend base URL (used to build verification links)
FRONTEND_URL=http://localhost:3000
# Email verification link expiration (hours)
EMAIL_VERIFICATION_EXPIRE_HOURS=24

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Security
SECRET_KEY=your_secret_key_for_jwt_signing
# Optional override for JWT secret
# JWT_SECRET_KEY=your_jwt_secret_key
# Access token lifetime (minutes)
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
# Refresh token lifetime (days, absolute)
REFRESH_TOKEN_EXPIRE_DAYS=30
# Cookie settings for refresh token
COOKIE_NAME_REFRESH=refresh_token
# Set to true in production (requires HTTPS)
COOKIE_SECURE=false
# Lax | Strict | None
COOKIE_SAMESITE=Lax
# Optional cookie domain (e.g., yourdomain.com); leave empty for localhost
# COOKIE_DOMAIN=yourdomain.com

CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
# Optional per-endpoint overrides
RATE_LIMIT_PAYMENTS_PACKAGES=120/minute
RATE_LIMIT_PAYMENTS_INTENT=10/minute
RATE_LIMIT_PAYMENTS_CONFIRM=30/minute
RATE_LIMIT_PAYMENTS_REFUND=5/minute
RATE_LIMIT_PAYMENTS_CUSTOMER=60/minute
RATE_LIMIT_PAYMENTS_HISTORY=30/minute
RATE_LIMIT_PODCAST_SEARCH=60/minute
RATE_LIMIT_PODCAST_EPISODES=60/minute
RATE_LIMIT_SUBMIT_EPISODE=6/minute
RATE_LIMIT_PODCAST_TRENDING=60/minute

# Audio validation
MAX_AUDIO_SIZE_MB=800
DOWNLOAD_TIMEOUT_SECONDS=20

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn_here

# =============================================================================
# OAUTH PROVIDERS (placeholders; Phase 2+)
# =============================================================================
# Google OAuth (OIDC)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Apple OAuth
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_CLIENT_ID=
# APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# =============================================================================
# DEVELOPMENT SPECIFIC SETTINGS
# =============================================================================
# Mock services for testing
MOCK_WHISPER=0
MOCK_OPENAI=0
MOCK_STRIPE=0

# Test mode settings
USE_LOCALSTACK=1
