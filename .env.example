# =============================================================================
# Media Summarizer — environment template
# =============================================================================
# Copy to .env at repo root (gitignored), fill in real values.
# python-dotenv loads .env automatically at package import time
# (see media_summarizer/__init__.py). In production, real env vars are
# injected by the runtime (Lambda/ECS) and override anything here.
#
# Sections (alphabetical inside each block):
#   1. RUNTIME             — environment, debug, logging, prestart
#   2. AWS / LOCALSTACK    — region, credentials, endpoint
#   3. STORAGE (S3)        — buckets
#   4. MESSAGING (SQS)     — queues
#   5. DATABASE (DynamoDB) — tables
#   6. AUTH                — JWT, cookies, CORS, frontend
#   7. SOCIAL AUTH         — Google + Apple Sign in
#   8. SOURCES             — Article, Instagram, PodcastIndex, TikTok, X, YouTube
#   9. TRANSCRIPTION       — Deepgram
#  10. LLM / ARTIFACTS     — OpenAI per-artifact models, retries
#  11. SEARCH              — Algolia
#  12. BILLING             — RevenueCat
#  13. EMAIL               — SES / SMTP
#  14. INGEST URL POLICY   — allow/block lists for ingestion
#  15. RATE LIMITING       — per-endpoint slowapi limits
#  16. WORKER TUNING       — visibility, heartbeats, retries
#  17. CONTENT VALIDATION  — audio/file size and duration caps
#  18. DIGEST / FORECASTS  — daily digest scheduling
# =============================================================================


# =============================================================================
# 1. RUNTIME
# =============================================================================
ENVIRONMENT=development        # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
USE_LOCALSTACK=1               # 0 in production
PRESTART_INFRA_CHECK=1         # set 0 in dev to skip infra health checks at API boot
API_SLOW_REQUEST_THRESHOLD_MS=2000


# =============================================================================
# 2. AWS / LOCALSTACK
# =============================================================================
AWS_DEFAULT_REGION=us-east-1
# Required in production. Leave commented for LocalStack dev.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# LocalStack endpoint (development only — unset in production).
AWS_ENDPOINT_URL=http://localhost:4566


# =============================================================================
# 3. STORAGE (S3)
# =============================================================================
AUDIO_BUCKET=media-summarizer-audio
TRANSCRIPT_BUCKET=media-summarizer-transcriptions
SUMMARY_BUCKET=media-summarizer-summaries
SUMMARY_SHORT_BUCKET=media-summarizer-summaries-short
SUMMARY_DETAILED_BUCKET=media-summarizer-summaries-detailed
NOTES_BUCKET=media-summarizer-notes
QUIZ_BUCKET=media-summarizer-quizzes
FLASHCARDS_BUCKET=media-summarizer-flashcards
DOCUMENT_BUCKET=media-summarizer-documents
ARCHIVE_BUCKET=media-summarizer-archives


# =============================================================================
# 4. MESSAGING (SQS)
# =============================================================================
# Ingestion
ARTICLE_EXTRACTION_QUEUE=article-extraction-queue
AUDIO_DOWNLOAD_QUEUE=audio-download-queue
DOCUMENT_PARSING_QUEUE=document-parsing-queue
INSTAGRAM_INGESTION_QUEUE=instagram-ingestion-queue
NEWSLETTER_INGESTION_QUEUE=newsletter-ingestion-queue
PODCASTINDEX_RESOLUTION_QUEUE=podcastindex-resolution-queue
RSS_FEED_POLL_QUEUE=rss-feed-poll-queue
TIKTOK_INGESTION_QUEUE=tiktok-ingestion-queue
X_INGESTION_QUEUE=x-ingestion-queue
YOUTUBE_INGESTION_QUEUE=youtube-ingestion-queue

# Transcription
DEEPGRAM_TRANSCRIPTION_QUEUE=deepgram-transcription-queue
TRANSCRIPTION_QUEUE=transcription-queue

# Artifact generation
SUMMARIZATION_QUEUE=summarization-queue
SUMMARY_SHORT_QUEUE=summary-short-queue
SUMMARY_DETAILED_QUEUE=summary-detailed-queue
NOTES_QUEUE=notes-queue
QUIZ_QUEUE=quiz-queue
FLASHCARDS_QUEUE=flashcards-queue

# Post-processing / events
# EPISODE_COMPLETION_EVENTS_QUEUE: emitted by ingestion orchestrator + X worker.
# EPISODE_COMPLETED_EVENTS_QUEUE: read by summarization + media_completed workers.
# (Two distinct queues today — keep both unless deduplicated upstream.)
EPISODE_COMPLETION_EVENTS_QUEUE=episode-completion-events
EPISODE_COMPLETED_EVENTS_QUEUE=episode-completed-events
SEARCH_INDEXING_QUEUE=search-indexing-queue


# =============================================================================
# 5. DATABASE (DynamoDB)
# =============================================================================
# Core
USERS_TABLE=users
PROCESSING_JOBS_TABLE=processing_jobs
AUTH_TOKENS_TABLE=auth_tokens

# Media flow
MEDIA_ARTIFACTS_TABLE=media_artifacts
MEDIA_IDEMPOTENCE_TABLE=media_idempotence
MEDIA_WATCHERS_TABLE=media_watchers
USER_MEDIA_SUBMISSIONS_TABLE=user_media_submissions

# Organisation (folders, tags, RSS feeds)
USER_FOLDERS_TABLE=user_folders
USER_TAGS_TABLE=user_tags
USER_RSS_FEEDS_TABLE=user_rss_feeds

# Spaced repetition
REVIEW_SCHEDULE_TABLE=review_schedule

# Billing / quotas
SUBSCRIPTIONS_TABLE=subscriptions
MINUTE_BUCKETS_TABLE=minute_buckets
MINUTE_USAGE_TABLE=minute_usage
REVENUCAT_EVENTS_TABLE=revenucat_events

# Pricing config
PRICING_CONFIG_TABLE=pricing_config

# Social graph
FOLLOWS_TABLE=follows

# Daily digest
USER_DIGESTS_TABLE=user_digests
FEED_FORECASTS_TABLE=feed_forecasts


# =============================================================================
# 6. AUTH
# =============================================================================
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
COOKIE_NAME_REFRESH=refresh_token
COOKIE_SECURE=false            # true in production (HTTPS only)
COOKIE_SAMESITE=Lax            # Lax | Strict | None
# COOKIE_DOMAIN=app.yourdomain.com   # leave unset for localhost
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Pricing admin (gates write access on pricing_config)
PRICING_ADMIN_SECRET=


# =============================================================================
# 7. SOCIAL AUTH (Google + Apple)
# =============================================================================
# Google OAuth (web client id is also the audience verified for mobile id_tokens)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Apple Sign in
APPLE_CLIENT_ID=               # Service ID (e.g. com.yourdomain.app.signinwithapple)
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=             # PEM, single line with \n escapes
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback


# =============================================================================
# 8. SOURCES
# =============================================================================
# Article extraction
ARTICLE_EXTRACT_TIMEOUT_SECONDS=20
ARTICLE_EXTRACT_MAX_HTML_BYTES=2000000
ARTICLE_EXTRACT_USER_AGENT=media-summarizer/article-extractor (+https://media-summarizer.local)

# Instagram (via GetInsaver)
GETINSAVER_API_BASE_URL=https://getinsaver.com/api/v1
GETINSAVER_API_KEY=
GETINSAVER_TIMEOUT_SECONDS=20

# PodcastIndex.org
PODCASTINDEXORG_API_KEY=
PODCASTINDEXORG_API_SECRET=
PODCAST_INDEX_TIMEOUT_SECONDS=20
PODCASTINDEX_EPISODE_CANDIDATES=50
PODCASTINDEX_RATE_LIMIT_ENABLED=true
PODCASTINDEX_RATE_LIMIT_RPS=1
PODCASTINDEX_LIMITER_REDIS_URL=redis://redis:6379/0
PODCASTINDEX_LIMITER_KEY=podcastindex:global:next_allowed_ms
PODCASTINDEX_LIMITER_TTL_MS=60000
PODCASTINDEX_MAX_RETRIES=3

# TikTok
TIKTOK_RATE_LIMIT_ENABLED=true
TIKTOK_RATE_LIMIT_PER_HOUR=100
TIKTOK_MIN_INTERVAL_SECONDS=3
TIKTOK_LIMITER_REDIS_URL=redis://redis:6379/0
TIKTOK_LIMITER_KEY=tiktok:global:next_allowed_ms
TIKTOK_LIMITER_TTL_MS=60000
TIKTOK_LIMITER_HOURLY_KEY_PREFIX=tiktok:global:hour_bucket
TIKTOK_SUBTITLE_FETCH_TIMEOUT_SECONDS=20

# X (Twitter)
X_API_BASE_URL=https://api.twitter.com/2
X_API_BEARER_TOKEN=
X_API_TIMEOUT_SECONDS=20

# YouTube (transcript-first via youtube-transcript-api, fallback Deepgram)
YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=20
YTDLP_TIMEOUT_SECONDS=30

# RSS feed polling
RSS_POLL_INTERVAL_SECONDS=900

# Document parsing (V1, task-90 validated): LlamaParse (free tier, primary)
# with Unstructured (15k free pages) as fallback. Both API keys are required.
LLAMAPARSE_API_KEY=
LLAMAPARSE_TIMEOUT_SECONDS=120
LLAMAPARSE_POLL_INTERVAL=2
LLAMAPARSE_MAX_POLLS=60
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io
UNSTRUCTURED_TIMEOUT_SECONDS=120


# =============================================================================
# 9. TRANSCRIPTION (Deepgram)
# =============================================================================
DEEPGRAM_API_KEY=
DEEPGRAM_API_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TIMEOUT_SECONDS=300
DEEPGRAM_API_RETRIES=3
DEEPGRAM_DETECT_LANGUAGE=true
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_PARAGRAPHS=true
DEEPGRAM_UTTERANCES=true


# =============================================================================
# 10. LLM / ARTIFACTS (OpenAI)
# =============================================================================
OPENAI_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.3

# Default model (used by all artifact types unless overridden below).
# Validated by owner — see docs/research/task-72-*/README.md.
OPENAI_MODEL=gpt-5.4-nano-2026-03-17

# Per-artifact overrides (optional)
SUMMARY_SHORT_LLM_MODEL=gpt-5-nano-2025-08-07
# SUMMARY_DETAILED_LLM_MODEL=
# NOTES_LLM_MODEL=
# FLASHCARDS_LLM_MODEL=

# Per-artifact retry caps
SUMMARY_MAX_RETRIES=3
NOTES_MAX_RETRIES=3
FLASHCARDS_MAX_RETRIES=3

# Comma-separated whitelist of artifact types the API accepts.
ARTIFACT_TYPES_ALLOWED=summary,summary_short,summary_detailed,quiz,notes,flashcards


# =============================================================================
# 11. SEARCH (Algolia)
# =============================================================================
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=               # admin key (backend-only, never expose to frontend)
ALGOLIA_INDEX_NAME=media_v1


# =============================================================================
# 12. BILLING (RevenueCat — replaces Stripe in V1, App Store / Play Store IAP)
# =============================================================================
REVENUCAT_API_KEY=
REVENUCAT_PROJECT_ID=
REVENUCAT_WEBHOOK_SECRET=
EXPIRED_HOLDS_BATCH_SIZE=100


# =============================================================================
# 13. INGEST URL POLICY
# =============================================================================
# Comma-separated. Leave empty to disable that filter.
INGEST_URL_ALLOWED_DOMAINS=
INGEST_URL_BLOCKED_DOMAINS=


# =============================================================================
# 14. RATE LIMITING (slowapi)
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PODCAST_SEARCH=60/minute
RATE_LIMIT_PODCAST_EPISODES=60/minute
RATE_LIMIT_PODCAST_TRENDING=60/minute
RATE_LIMIT_SUBMIT_EPISODE=6/minute


# =============================================================================
# 15. WORKER TUNING
# =============================================================================
HEARTBEAT_INTERVAL=60
SQS_VISIBILITY_TIMEOUT=300
TRANSCRIPTION_VISIBILITY_TIMEOUT=1800
DEEPGRAM_VISIBILITY_TIMEOUT=1800
DOCUMENT_PARSING_VISIBILITY_TIMEOUT=1800
ARTICLE_WORKER_MAX_RETRIES=3
DEEPGRAM_WORKER_MAX_RETRIES=3
PODCASTINDEX_WORKER_MAX_RETRIES=3
TIKTOK_WORKER_MAX_RETRIES=3
X_WORKER_MAX_RETRIES=3


# =============================================================================
# 16. CONTENT VALIDATION
# =============================================================================
MAX_AUDIO_SIZE_MB=800
MAX_AUDIO_DURATION=14400       # seconds (4 hours)
MAX_FILE_SIZE=104857600        # bytes (100 MB) — uploads
DOWNLOAD_TIMEOUT_SECONDS=20


# =============================================================================
# 17. DIGEST / FORECASTS
# =============================================================================
DEFAULT_FORECAST_DURATION_MINUTES=30
DIGEST_STAGGER_DELAY_SECONDS=2
FORECAST_FETCH_LIMIT=50
