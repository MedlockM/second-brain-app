# =============================================================================
# Media Summarizer — environment template
# =============================================================================
# Copy to .env at repo root (gitignored), fill in real values.
# python-dotenv loads .env automatically at package import time
# (see media_summarizer/__init__.py). In production, real env vars are
# injected by the runtime (Lambda/ECS) and override anything here.
#
# Sections (alphabetical inside each block):
#   1. RUNTIME             — environment, debug, logging, prestart
#   2. AWS                 — region, credentials, runtime secret
#   3. STORAGE (S3)        — buckets
#   4. MESSAGING (SQS)     — queues
#   5. DATABASE (DynamoDB) — tables
#   6. AUTH                — JWT, cookies, CORS, frontend
#   7. SOCIAL AUTH         — Google + Apple Sign in
#   8. SOURCES             — Article, Instagram, PodcastIndex, TikTok, X, YouTube
#   9. TRANSCRIPTION       — Deepgram
#  10. LLM / ARTIFACTS     — OpenAI per-artifact models, retries
#  11. SEARCH              — Algolia
#  12. BILLING             — RevenueCat
#  13. INGEST URL POLICY   — allow/block lists for ingestion
#  14. RATE LIMITING       — per-endpoint slowapi limits
#  15. WORKER TUNING       — visibility, heartbeats, retries
#  16. CONTENT VALIDATION  — audio/file size and duration caps
#  17. DIGEST / FORECASTS  — daily digest scheduling
#  18. FEEDBACK            — Canny SSO and board
#  19. BUG REPORTS         — storage, quotas, triage routing
#  20. TESTS / E2E         — flags read only by the test suites
#
# scripts/check_env_example_complete.py fails the build when a variable the code
# reads, or one Terraform injects, is missing from this file.
# =============================================================================


# =============================================================================
# 1. RUNTIME
# =============================================================================
ENVIRONMENT=development        # development | staging | production
DEBUG=false
LOG_LEVEL=INFO
PRESTART_INFRA_CHECK=1         # set 0 in dev to skip infra health checks at API boot
API_SLOW_REQUEST_THRESHOLD_MS=2000


# =============================================================================
# 2. AWS
# =============================================================================
AWS_DEFAULT_REGION=eu-west-3
# AWS_REGION wins over AWS_DEFAULT_REGION (utils/database_async.py): the Lambda
# runtime sets it, botocore does not read it. Leave it unset locally so the two
# cannot disagree — one region per environment.
# AWS_REGION=eu-west-3
# Required in production. Leave commented for IAM role/IMDS chain (Lambda, ECS, EC2).
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # temporary credentials only (assumed role, SSO)

# Consolidated Secrets Manager secret holding every third-party credential.
# Set ONLY in deployed environments: the Lambda entrypoints read it at cold start
# and inject each key into os.environ (api/lambda_handler.py). Locally the values
# live in this .env instead, so leave it unset.
# RUNTIME_SECRET_NAME=media-summarizer-runtime-dev


# =============================================================================
# 3. STORAGE (S3)
# =============================================================================
# EVERY AWS resource name below is environment-specific and has NO fallback in
# the code (task-237): a missing variable raises at import time instead of
# silently reading the dev resource. The values below are the DEV names — the
# ones a laptop and the E2E suite target. For another environment, read them from
# `terraform -chdir=infrastructure/terraform/envs/<env> output` instead of
# editing the suffix by hand.
AUDIO_BUCKET=media-summarizer-audio-125313707865-dev
TRANSCRIPT_BUCKET=media-summarizer-transcripts-125313707865-dev
SUMMARY_BUCKET=media-summarizer-summaries-125313707865-dev
SUMMARY_SHORT_BUCKET=media-summarizer-summary-short-125313707865-dev
SUMMARY_DETAILED_BUCKET=media-summarizer-summary-detailed-125313707865-dev
NOTES_BUCKET=media-summarizer-notes-125313707865-dev
QUIZ_BUCKET=media-summarizer-quiz-125313707865-dev
FLASHCARDS_BUCKET=media-summarizer-flashcards-125313707865-dev
# Internal artifact (task-323): the short prose blurb the triage screen reads off
# the library row. Same one-bucket-per-type layout as the five above.
REVIEW_BLURB_BUCKET=media-summarizer-review-blurb-125313707865-dev
DOCUMENT_BUCKET=media-summarizer-documents-125313707865-dev
ARCHIVE_BUCKET=media-summarizer-archives-125313707865-dev
# Re-hosted media covers (task-304). Private, read through a presigned URL.
# Only the sources whose cover URL is signed and expiring (Instagram, TikTok) or
# private (camera and gallery photos) land here; an article's og:image and a
# YouTube `i.ytimg.com` thumbnail are hotlinked and touch no bucket.
COVERS_BUCKET=media-summarizer-covers-125313707865-dev


# =============================================================================
# 4. MESSAGING (SQS)
# =============================================================================
# Ingestion
ARTICLE_EXTRACTION_QUEUE=article-extraction-queue-dev
DOCUMENT_PARSING_QUEUE=document-parsing-queue-dev
INSTAGRAM_INGESTION_QUEUE=instagram-ingestion-queue-dev
PODCASTINDEX_RESOLUTION_QUEUE=podcastindex-resolution-queue-dev
RSS_FEED_POLL_QUEUE=rss-feed-poll-queue-dev
TIKTOK_INGESTION_QUEUE=tiktok-ingestion-queue-dev
X_INGESTION_QUEUE=x-ingestion-queue-dev
YOUTUBE_INGESTION_QUEUE=youtube-ingestion-queue-dev

# Transcription
DEEPGRAM_TRANSCRIPTION_QUEUE=deepgram-transcription-queue-dev

# Artifact generation
ARTIFACT_GENERATOR_QUEUE=artifact-generator-queue-dev
TRANSCRIPT_TRANSLATION_QUEUE=transcript-translation-queue-dev

# Post-processing / events
# EPISODE_COMPLETED_EVENTS_QUEUE: emitted by all ingestion/transcription workers,
# consumed by the artifact generator + media_completed workers.
EPISODE_COMPLETED_EVENTS_QUEUE=episode-completed-events-dev
SEARCH_INDEXING_QUEUE=search-indexing-queue-dev


# =============================================================================
# 5. DATABASE (DynamoDB)
# =============================================================================
# Core
USERS_TABLE=users-dev
PROCESSING_JOBS_TABLE=processing_jobs-dev
AUTH_TOKENS_TABLE=auth_tokens-dev

# Media flow
# user_media is the durable library and the single source of truth for every
# library, Search and folder read. Every save writes it unconditionally.
USER_MEDIA_TABLE=user_media-dev
# Optional override; must match the media_key GSI on USER_MEDIA_TABLE.
# USER_MEDIA_MEDIA_KEY_INDEX=media-key-index
MEDIA_ARTIFACTS_TABLE=media_artifacts-dev
MEDIA_ARTIFACTS_SCOPE_INDEX=scope-index
MEDIA_IDEMPOTENCE_TABLE=media_idempotence-dev
MEDIA_WATCHERS_TABLE=media_watchers-dev
TRANSLATION_IDEMPOTENCE_TABLE=translation_idempotence-dev

# Organisation (folders, tags, RSS feeds)
USER_FOLDERS_TABLE=user_folders-dev
USER_TAGS_TABLE=user_tags-dev
USER_RSS_FEEDS_TABLE=user_rss_feeds-dev

# Spaced repetition
REVIEW_SCHEDULE_TABLE=review_schedule-dev
USER_REVIEW_SETTINGS_TABLE=user_review_settings-dev

# Billing / quotas
SUBSCRIPTIONS_TABLE=subscriptions-dev
REVENUCAT_EVENTS_TABLE=revenucat_events-dev

# Pricing config
PRICING_CONFIG_TABLE=pricing_config-dev

# Quota enforcement (usage counters)
USER_USAGE_MONTHLY_TABLE=user_usage_monthly-dev
USER_USAGE_DAILY_TABLE=user_usage_daily-dev

# Social graph
FOLLOWS_TABLE=follows-dev

# Daily digest
USER_DIGESTS_TABLE=user_digests-dev
USER_DIGEST_SETTINGS_TABLE=user_digest_settings-dev
FEED_FORECASTS_TABLE=feed_forecasts-dev


# =============================================================================
# 6. AUTH
# =============================================================================
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
# Access token lifetime. 60 minutes is safe because revocation does not depend on it:
# get_current_user re-reads the user from DynamoDB on every request, so a deleted
# account is rejected at once whatever the JWT still claims.
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
# Refresh token lifetime, applied as a SLIDING window with no absolute cap: every
# /refresh rotation reposes the expiry at now + this many days instead of inheriting
# the login date. An active user therefore never has to sign in again, while a device
# left untouched for a year stops being refreshable (task-294).
REFRESH_TOKEN_EXPIRE_DAYS=365
# SECRET_KEY is a legacy fallback for JWT_SECRET_KEY (utils/auth_utils.py:17).
# Set JWT_SECRET_KEY, not this one: if both are set, JWT_SECRET_KEY wins and this
# value is silently ignored, which reads as a rotation that took effect when it
# did not.
# SECRET_KEY=
# Token lifetime overrides, all optional and all zero/derived by default. Every
# one of them is an override of JWT_ACCESS_TOKEN_EXPIRE_MINUTES above; prefer
# that single knob unless a dev flow needs seconds-scale expiry.
#   JWT_ACCESS_TOKEN_EXPIRE_SECONDS   non-zero wins over _MINUTES (dev only)
#   ACCESS_TOKEN_EXPIRE_HOURS         else derived by rounding _MINUTES up
#   JWT_EXPIRATION_HOURS              read by core/config.py only, unused by the
#                                     token codec — do not expect it to change
#                                     an issued token's expiry
#   REFRESH_TOKEN_EXPIRE_MINUTES / _SECONDS   non-zero wins over _DAYS (dev only)
# JWT_ACCESS_TOKEN_EXPIRE_SECONDS=0
# ACCESS_TOKEN_EXPIRE_HOURS=
# JWT_EXPIRATION_HOURS=24
# REFRESH_TOKEN_EXPIRE_MINUTES=0
# REFRESH_TOKEN_EXPIRE_SECONDS=0
# No COOKIE_* variables: the refresh token travels in the JSON body of
# register/login/refresh, not in an httpOnly cookie. The only client is the
# mobile app, which cannot read one (task-293). One key of the runtime secret
# (COOKIE_DOMAIN) is a dead leftover of that transport — see
# docs/DEVBOX_SETUP.md.
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Pricing admin (gates write access on pricing_config)
PRICING_ADMIN_SECRET=


# =============================================================================
# 7. SOCIAL AUTH (Google + Apple)
# =============================================================================
# Google OAuth. Three OAuth client IDs exist (web, iOS, Android) and all three are
# public identifiers — only GOOGLE_CLIENT_SECRET is a secret, and it belongs to the
# web client alone. The audience of an id_token is the client its authorization code
# was exchanged against, so the mobile app never produces a token with the web
# client as `aud` (task-298): the two GOOGLE_NATIVE_AUDIENCE_* keys below are what
# /auth/google/native accepts, mirroring APPLE_NATIVE_AUDIENCE.
GOOGLE_CLIENT_ID=              # Web client — used by the web /auth/google/callback flow
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback
# Same values as EXPO_PUBLIC_GOOGLE_CLIENT_ID_IOS / _ANDROID in mobile/eas.json.
GOOGLE_NATIVE_AUDIENCE_IOS=      # iOS OAuth client ID (public), e.g. <digits>-<guid>.apps.googleusercontent.com
GOOGLE_NATIVE_AUDIENCE_ANDROID=  # Android OAuth client ID (public), same shape

# Apple Sign in
APPLE_CLIENT_ID=               # Service ID for the web callback flow (e.g. com.secondbrainlabs.core.signinwithapple)
APPLE_NATIVE_AUDIENCE=         # iOS app bundle id for the native flow — must equal mobile/app.config.ts ios.bundleIdentifier (e.g. com.secondbrainlabs.core)
APPLE_TEAM_ID=
APPLE_KEY_ID=
# APPLE_PRIVATE_KEY: PEM, single line with \n escapes. No quotes, and no comment
# on this line — the value below has already been copied verbatim into Secrets
# Manager once, quotes and trailing comment included, which broke Apple Sign-In in
# the deployed environment (task-136). python-dotenv strips both when reading a
# .env, so the damage only shows up after the value leaves this file.
APPLE_PRIVATE_KEY=
APPLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/apple/callback


# =============================================================================
# 8. SOURCES
# =============================================================================
# Article extraction
ARTICLE_EXTRACT_TIMEOUT_SECONDS=20
ARTICLE_EXTRACT_MAX_HTML_BYTES=2000000
ARTICLE_EXTRACT_USER_AGENT=media-summarizer/article-extractor (+https://media-summarizer.local)

# Instagram (via Apify actors)
# Use ~ as namespace separator (e.g. apify~instagram-post-scraper).
# The worker auto-normalizes / to ~ but the canonical form uses ~.
APIFY_INSTAGRAM_API_TOKEN=
APIFY_INSTAGRAM_REEL_ACTOR_ID=apify~instagram-reel-scraper
APIFY_INSTAGRAM_POST_ACTOR_ID=apify~instagram-post-scraper
APIFY_INSTAGRAM_COMMENT_ACTOR_ID=apify~instagram-comment-scraper
# Provider HTTP calls only start a run or fetch an already-terminal dataset.
APIFY_REQUEST_TIMEOUT_SECONDS=15
# Server-side actor deadline; workers never wait for it inline.
APIFY_ACTOR_TIMEOUT_SECONDS=600
# Public callback target. Terraform injects the deployed API Gateway URL.
APIFY_WEBHOOK_URL=http://localhost:8000/api/webhooks/apify
# Shared Bearer credential; store the deployed value in Secrets Manager only.
APIFY_WEBHOOK_SECRET=
# Minimum character count to accept Apify-provided transcript (bypass Deepgram)
INSTAGRAM_TRANSCRIPT_MIN_LENGTH=20
# Feature flag: set to false to disable Apify transcript bypass (always use Deepgram)
INSTAGRAM_USE_APIFY_TRANSCRIPT=true

# YouTube (via Apify actor)
# The transcript language comes from the user's reading_language preference
# (task-216), no longer from a global env var. Two actors are supported:
#   - starvibe~youtube-video-transcript              accepts `language` (recommended)
#   - scrape-creators~best-youtube-transcripts-scraper  no language control
# Any other actor id fails fast with `apify_actor_unsupported`. Deployed
# environments read this from Secrets Manager, NOT from this file.
APIFY_YOUTUBE_API_TOKEN=
APIFY_YOUTUBE_TRANSCRIPT_ACTOR_ID=starvibe~youtube-video-transcript

# PodcastIndex.org
PODCASTINDEXORG_API_KEY=
PODCASTINDEXORG_API_SECRET=
PODCAST_INDEX_TIMEOUT_SECONDS=20
PODCASTINDEX_EPISODE_CANDIDATES=50
PODCASTINDEX_RATE_LIMIT_ENABLED=true
PODCASTINDEX_RATE_LIMIT_RPS=1
PODCASTINDEX_LIMITER_REDIS_URL=redis://redis:6379/0
PODCASTINDEX_LIMITER_KEY=podcastindex:global:next_allowed_ms
PODCASTINDEX_LIMITER_TTL_MS=60000
PODCASTINDEX_MAX_RETRIES=3

# TikTok
TIKTOK_RATE_LIMIT_ENABLED=true
TIKTOK_RATE_LIMIT_PER_HOUR=100
TIKTOK_MIN_INTERVAL_SECONDS=3
TIKTOK_LIMITER_REDIS_URL=redis://redis:6379/0
TIKTOK_LIMITER_KEY=tiktok:global:next_allowed_ms
TIKTOK_LIMITER_TTL_MS=60000
TIKTOK_LIMITER_HOURLY_KEY_PREFIX=tiktok:global:hour_bucket
TIKTOK_SUBTITLE_FETCH_TIMEOUT_SECONDS=20

# TikTok — Apify fallback (triggered only on IP block / status 10204)
APIFY_TIKTOK_API_TOKEN=
APIFY_TIKTOK_TRANSCRIPT_ACTOR_ID=

# X (Twitter)
X_API_BASE_URL=https://api.twitter.com/2
X_API_BEARER_TOKEN=
X_API_TIMEOUT_SECONDS=20

# YouTube (Apify YouTube Transcript actor only -- task-309 removed the yt-dlp
# branch; see docs/INGESTION_WORKERS_PROVIDERS.md, section YouTube)
YOUTUBE_TRANSCRIPT_TIMEOUT_SECONDS=20
# Read by the TikTok worker and the Instagram resolver, not by YouTube anymore
YTDLP_TIMEOUT_SECONDS=30

# RSS feed polling
RSS_POLL_INTERVAL_SECONDS=900

# Document parsing (V1, task-90 validated): LlamaParse (free tier, primary)
# with Unstructured (15k free pages) as fallback. Both API keys are required.
LLAMAPARSE_API_KEY=
LLAMAPARSE_TIMEOUT_SECONDS=120
LLAMAPARSE_POLL_INTERVAL=2
LLAMAPARSE_MAX_POLLS=60
# First-page cover fetch (task-344): two extra GETs on an already-billed job. The
# byte ceiling keeps a surprising payload out of a 512 MB worker; observed page
# renders ranged from 176 KB to 1.0 MB.
LLAMAPARSE_PAGE_IMAGE_TIMEOUT_SECONDS=20
LLAMAPARSE_PAGE_IMAGE_MAX_BYTES=8388608 # 8 MB
UNSTRUCTURED_API_KEY=
UNSTRUCTURED_API_URL=https://api.unstructuredapp.io
UNSTRUCTURED_TIMEOUT_SECONDS=120


# =============================================================================
# 9. TRANSCRIPTION (Deepgram)
# =============================================================================
DEEPGRAM_API_KEY=
DEEPGRAM_API_URL=https://api.deepgram.com/v1/listen
DEEPGRAM_MODEL=nova-3
DEEPGRAM_TIMEOUT_SECONDS=300
DEEPGRAM_API_RETRIES=3
DEEPGRAM_DETECT_LANGUAGE=true
DEEPGRAM_SMART_FORMAT=true
DEEPGRAM_PUNCTUATE=true
DEEPGRAM_PARAGRAPHS=true
DEEPGRAM_UTTERANCES=true
# Speaker diarization is a paid Deepgram add-on ($0.0020/min, i.e. +41.7% over the
# Nova-3 promotional rate) and is NOT required for readable paragraphs — see
# docs/research/task-231-transcript-formatting/README.md. Keep it false unless the
# owner accepts the extra cost. When true, the worker sends `diarize_model`
# (`diarize=true` is deprecated by Deepgram); the transcript then carries in-band
# "Speaker N:" prefixes that the mobile viewer renders as labels.
DEEPGRAM_DIARIZE=false
DEEPGRAM_DIARIZE_MODEL=v2


# =============================================================================
# 10. LLM / ARTIFACTS (OpenAI)
# =============================================================================
OPENAI_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_TIMEOUT_SECONDS=60
LLM_TEMPERATURE=0.3

# Default model (used by all artifact types unless overridden below).
# Validated by owner — see docs/research/task-72-*/README.md.
OPENAI_MODEL=gpt-5.4-nano-2026-03-17

# Per-artifact overrides (optional)
SUMMARY_SHORT_LLM_MODEL=gpt-5-nano-2025-08-07
# SUMMARY_DETAILED_LLM_MODEL=
# NOTES_LLM_MODEL=
# FLASHCARDS_LLM_MODEL=

# Transcript translation (task-192) — common source-agnostic detect+translate step.
# Model validated by owner — see docs/research/task-189-*/README.md (GPT-5-nano).
TRANSLATION_LLM_MODEL=gpt-5-nano-2025-08-07
TRANSLATION_TIMEOUT_SECONDS=180
TRANSLATION_MAX_RETRIES=3
TRANSLATION_BACKOFF_BASE_SECONDS=1.0

# Per-artifact retry caps
SUMMARY_MAX_RETRIES=3
NOTES_MAX_RETRIES=3
FLASHCARDS_MAX_RETRIES=3

# Guard rails of the review_blurb backfill CLI
# (`uv run python -m media_summarizer.scripts.backfill_review_blurbs`, task-323).
# The delay staggers generations so a backfill does not starve the interactive ones;
# the limit caps one run, and 0 makes it a dry run that only counts.
REVIEW_BLURB_BACKFILL_DELAY_SECONDS=2.0
REVIEW_BLURB_BACKFILL_LIMIT=25

# Guard rail of the review_blurb purge CLI
# (`uv run python -m media_summarizer.scripts.purge_review_blurbs`). Run before the
# backfill when the blurb's shape changes: a prompt bump alone regenerates nothing,
# because the artifact id excludes the generator version. 0 makes it a dry run.
REVIEW_BLURB_PURGE_LIMIT=200

# Comma-separated whitelist of artifact types the pipeline may generate. Must match
# the default derived from MediaArtifactType in core/models/media_artifact.py.
# `review_blurb` belongs here — it is generated by a backend trigger, not requestable
# — while the legacy `summary` type stopped existing several tasks ago.
ARTIFACT_TYPES_ALLOWED=summary_short,summary_detailed,quiz,notes,flashcards,review_blurb


# =============================================================================
# 11. SEARCH (Algolia)
# =============================================================================
ALGOLIA_APP_ID=
ALGOLIA_API_KEY=               # admin key (backend-only, never expose to frontend)
# No index-name variable: the index is `media_items_{ENVIRONMENT}`, derived by
# utils/algolia_client.py. Search is backend-proxied, so no Algolia key is ever
# handed to a client (task-312).


# =============================================================================
# 12. BILLING (RevenueCat — replaces Stripe in V1, App Store / Play Store IAP)
# =============================================================================
REVENUCAT_API_KEY=
REVENUCAT_PROJECT_ID=
REVENUCAT_WEBHOOK_SECRET=
EXPIRED_HOLDS_BATCH_SIZE=100


# =============================================================================
# 13. INGEST URL POLICY
# =============================================================================
# Comma-separated. Leave empty to disable that filter.
INGEST_URL_ALLOWED_DOMAINS=
INGEST_URL_BLOCKED_DOMAINS=


# =============================================================================
# 14. RATE LIMITING (slowapi)
# =============================================================================
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PODCAST_SEARCH=60/minute
RATE_LIMIT_PODCAST_EPISODES=60/minute
RATE_LIMIT_PODCAST_TRENDING=60/minute
RATE_LIMIT_SUBMIT_EPISODE=6/minute


# =============================================================================
# 15. WORKER TUNING
# =============================================================================
HEARTBEAT_INTERVAL=60
SQS_VISIBILITY_TIMEOUT=300
TRANSCRIPTION_VISIBILITY_TIMEOUT=1800
DEEPGRAM_VISIBILITY_TIMEOUT=1800
DOCUMENT_PARSING_VISIBILITY_TIMEOUT=1800
ARTICLE_WORKER_MAX_RETRIES=3
ARTIFACT_GENERATOR_MAX_RETRIES=3
DEEPGRAM_WORKER_MAX_RETRIES=3
INSTAGRAM_WORKER_MAX_RETRIES=3
PODCASTINDEX_WORKER_MAX_RETRIES=3
TIKTOK_WORKER_MAX_RETRIES=3
X_WORKER_MAX_RETRIES=3

# DynamoDB TTL on the processing_jobs rows. Clamped to 30..90 by the model; any
# value outside that range, or unparseable, silently falls back to 90.
PROCESSING_JOBS_TTL_DAYS=90

# Fetching a cover to re-host (task-304). Both are optional overrides of the
# defaults in core/services/cover_capture.py: a cover is best-effort, so a
# timeout or an oversized source leaves the tile on its media-type icon rather
# than failing the ingestion. The size ceiling exists for the user-photo path,
# where the source can legitimately be 50 MB.
# COVER_FETCH_TIMEOUT_SECONDS=10
# COVER_MAX_SOURCE_BYTES=12582912   # 12 MB
# Several CDNs answer 403 to the default httpx agent. The guard above does not
# catch this one -- its `os.environ.get` call is split across lines -- so it is
# declared by hand.
# COVER_FETCH_USER_AGENT=

# SQS queue for push notifications. Terraform creates it in no environment yet, so
# it is intentionally empty: the weekly digest skips publishing rather than
# erroring against a queue that does not exist (workers/digest/scheduler.py).
PUSH_NOTIFICATION_QUEUE=


# =============================================================================
# 16. CONTENT VALIDATION
# =============================================================================
MAX_AUDIO_SIZE_MB=800
MAX_AUDIO_DURATION=14400       # seconds (4 hours)
MAX_FILE_SIZE=104857600        # bytes (100 MB) — uploads
DOWNLOAD_TIMEOUT_SECONDS=20

# Upload and share-extension caps enforced by the media endpoints. The two
# MAX_SHARED_* values mirror constants in the mobile client: raising one here
# without the other only moves where the rejection happens.
AUDIO_PRESIGNED_URL_EXPIRATION=600   # seconds of validity for an upload URL
UPLOAD_PRESIGNED_URL_EXPIRATION=900  # seconds of validity for a staged presigned PUT
MAX_UPLOAD_SIZE_BYTES=52428800       # 50 MB
MAX_SHARED_AUDIO_SIZE_BYTES=26214400 # 25 MB
MAX_SHARED_TEXT_LENGTH=50000         # characters


# =============================================================================
# 17. DIGEST / FORECASTS
# =============================================================================
DEFAULT_FORECAST_DURATION_MINUTES=30
DIGEST_STAGGER_DELAY_SECONDS=2
FORECAST_FETCH_LIMIT=50


# =============================================================================
# 18. FEEDBACK (Canny — user feature requests board)
# =============================================================================
# SSO private key from Canny dashboard (Settings > SSO). Used to sign JWT tokens
# so users are auto-identified on the feedback board without re-login.
CANNY_SSO_PRIVATE_KEY=
# Board token from Canny dashboard (Settings > Board Tokens). Identifies which
# board to display in the mobile WebView widget.
CANNY_BOARD_TOKEN=

# =============================================================================
# 19. BUG REPORTS (task-128)
# =============================================================================
BUG_REPORTS_BUCKET=media-summarizer-bug-reports-125313707865-dev
BUG_REPORTS_TABLE=bug_reports-dev
BUG_REPORT_MAX_FILE_SIZE=52428800   # 50 MB
BUG_REPORT_RATE_LIMIT_PER_HOUR=5
# Discord webhook URL for routing bug reports to triage channel.
# Leave empty to disable routing (reports are still persisted in DB).
BUG_REPORT_ROUTING_WEBHOOK=


# =============================================================================
# 20. TESTS / E2E
# =============================================================================
# All commented out on purpose: these shorten backoffs, skip cleanup or stub out
# processing, and the E2E suite sets what it needs itself (tests/e2e/README.md).
# A value left set in a .env after a debugging session degrades the app quietly —
# TEST_MODE alone drops the media_completed retry delay from 2s to 10ms.
# TEST_MODE=false                 # true shortens worker retry backoff
# TEST_ENVIRONMENT=               # non-empty marks the process as a test run
# E2E_CLEANUP=true                # false keeps E2E fixtures for post-mortem
# ENABLE_MOCK_PROCESSING=false    # true stubs artifact generation
# FORCE_DEEPGRAM_PUSH_MODE=       # "1" forces the push-mode fallback path
